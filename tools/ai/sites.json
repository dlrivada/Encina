{
  "schema": 1,
  "baseUrl": "https://dlrivada.github.io/Encina",
  "sites": [
    {
      "id": "docs",
      "name": "Documentation site",
      "kind": "docs",
      "path": "",
      "expectHtml": true,
      "publisher": "docs.yml"
    },
    {
      "id": "api",
      "name": "API reference (DocFX)",
      "kind": "api",
      "path": "api/",
      "expectHtml": false,
      "publisher": "docs.yml"
    },
    {
      "id": "coverage",
      "name": "Coverage dashboard",
      "kind": "dashboard",
      "path": "coverage/",
      "expectHtml": false,
      "dataPath": "coverage/data/latest.json",
      "timestampField": "timestamp",
      "publisher": "publish-coverage.yml",
      "maxAgeDays": 8
    },
    {
      "id": "mutations",
      "name": "Mutation dashboard",
      "kind": "dashboard",
      "path": "mutations/",
      "expectHtml": false,
      "dataPath": "mutations/data/latest.json",
      "timestampField": "timestamp",
      "publisher": "publish-mutations.yml",
      "maxAgeDays": 8,
      "trackingIssue": 1395
    },
    {
      "id": "benchmarks",
      "name": "Benchmark dashboard",
      "kind": "dashboard",
      "path": "benchmarks/dashboard/",
      "expectHtml": false,
      "dataPath": "benchmarks/data/latest.json",
      "timestampField": "timestamp",
      "publisher": "publish-benchmarks.yml",
      "maxAgeDays": 8
    },
    {
      "id": "performance",
      "name": "Performance measurement infrastructure",
      "kind": "dashboard",
      "path": "performance/",
      "expectHtml": false,
      "publisher": "docs.yml"
    },
    {
      "id": "load-tests",
      "name": "Load-test dashboard",
      "kind": "dashboard",
      "path": "load-tests/dashboard/",
      "expectHtml": false,
      "dataPath": "load-tests/data/latest.json",
      "timestampField": "timestamp",
      "publisher": "publish-load-tests.yml",
      "maxAgeDays": 8
    }
  ]
}

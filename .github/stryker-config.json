{
  "$schema": "https://stryker-mutator.io/schema/stryker.schema.json",
  "stryker-config": {
    "project": "Encina.csproj",
    "test-runner": "mtp",
    "reporters": [
      "progress",
      "json",
      "cleartext"
    ],
    "concurrency": 1,
    "break-on-initial-test-failure": true,
    "coverage-analysis": "off",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/*.cs",
      "!**/Log.cs",
      "!**/LogMessages.cs",
      "!**/Diagnostics/*ActivitySource.cs",
      "!**/Diagnostics/*Metrics.cs",
      "!**/*Errors.cs",
      "!**/*Constants.cs"
    ]
  }
}

    "facts": { "ci-run:ci-full.yml": { "value": { "runs": [ { "id": 1, "event": "schedule", "status": "completed", "conclusion": "success", "headSha": "0123456789abcdef0123456789abcdef01234567", "createdAt": "2026-10-19T03:00:00Z", "jobs": [ { "name": "build", "conclusion": "success" }, { "name": "test-unit", "conclusion": "success" } ] } ] } } },
    "expect": "PASS"
  },
  {
    "name": "ci-run fails when one job is skipped",
    "check": { "name": "ci-run", "params": { "workflow": "ci-full.yml", "events": ["schedule", "workflow_dispatch"] } },
    "facts": { "ci-run:ci-full.yml": { "value": { "runs": [ { "id": 1, "event": "schedule", "status": "completed", "conclusion": "success", "headSha": "0123456789abcdef0123456789abcdef01234567", "createdAt": "2026-10-19T03:00:00Z", "jobs": [ { "name": "build", "conclusion": "success" }, { "name": "test-unit", "conclusion": "skipped" } ] } ] } } },

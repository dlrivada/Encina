    "facts": { "spec-verified:docs/spec.md": { "value": { "date": null } } },
    "expect": "FAIL"
  },
  {
    "name": "milestone-clean passes when every open issue is in the sign-off allow-list",
    "check": { "name": "milestone-clean", "params": {} },
    "facts": { "milestone:0.14.0": { "value": { "milestone": { "number": 3, "title": "v0.14.0 - Fixture" }, "open": [ { "number": 5, "title": "carried" } ] } } },
    "signoff": "- allow-open: #5 — carried to the next block\n",
    "expect": "PASS"
  },
  {
    "name": "milestone-clean fails on an open issue outside the allow-list",
    "check": { "name": "milestone-clean", "params": {} },
    "facts": { "milestone:0.14.0": { "value": { "milestone": { "number": 3, "title": "v0.14.0 - Fixture" }, "open": [ { "number": 5, "title": "carried" } ] } } },
    "expect": "FAIL",
    "contains": "#5"
  },
  {
    "name": "milestone-clean fails when no milestone matches the version",
    "check": { "name": "milestone-clean", "params": {} },
    "facts": { "milestone:0.14.0": { "value": { "milestone": null, "open": [] } } },
    "expect": "FAIL"
  },
  {
    "name": "nuget-listing passes when the version is listed",
    "check": { "name": "nuget-listing", "params": { "packageId": "Encina", "pattern": "^{version}$" } },
    "facts": { "nuget:Encina": { "value": { "versions": ["0.13.0", "0.14.0"] } } },
    "expect": "PASS"
  },
  {
    "name": "nuget-listing fails when the version is not listed",
    "check": { "name": "nuget-listing", "params": { "packageId": "Encina", "pattern": "^{version}$" } },
    "facts": { "nuget:Encina": { "value": { "versions": ["0.13.0"] } } },
    "expect": "FAIL"
  },
  {
    "name": "release-asset passes when enough assets match",
    "check": { "name": "release-asset", "params": { "namePattern": "(?i)sbom", "minCount": 1 } },
    "facts": { "release:v0.14.0": { "value": { "exists": true, "assets": ["Encina.sbom.json"] } } },
    "expect": "PASS"
  },
  {
    "name": "release-asset fails when no asset matches",
    "check": { "name": "release-asset", "params": { "namePattern": "(?i)sbom", "minCount": 1 } },
    "facts": { "release:v0.14.0": { "value": { "exists": true, "assets": [] } } },
    "expect": "FAIL"
  },
  {
    "name": "release-asset fails when the release does not exist",
    "check": { "name": "release-asset", "params": { "namePattern": "(?i)sbom", "minCount": 0 } },
    "facts": { "release:v0.14.0": { "value": { "exists": false, "assets": [] } } },
    "expect": "FAIL",
    "contains": "no GitHub Release"
  },
  {
    "name": "exclusive-dirs passes when only one family exists",
    "check": { "name": "exclusive-dirs", "params": { "globs": ["src/Encina.Secrets.*", "src/Encina.Security.Secrets.*"] } },
    "facts": { "dirs:src/Encina.Secrets.*|src/Encina.Security.Secrets.*": { "value": { "counts": { "src/Encina.Secrets.*": 0, "src/Encina.Security.Secrets.*": 2 } } } },
    "expect": "PASS"
  },
  {
    "name": "exclusive-dirs fails when both families exist",
    "check": { "name": "exclusive-dirs", "params": { "globs": ["src/Encina.Secrets.*", "src/Encina.Security.Secrets.*"] } },
    "facts": { "dirs:src/Encina.Secrets.*|src/Encina.Security.Secrets.*": { "value": { "counts": { "src/Encina.Secrets.*": 1, "src/Encina.Security.Secrets.*": 2 } } } },
    "expect": "FAIL"
  }
